# Copy to config.env (git-ignored) and adjust. Sourced by the other scripts.

# Azure for Students only allows ~5 regions (they differ per person). 01-setup.sh checks the size below is
# actually deployable in this region and falls back through VM_FALLBACK_SIZES.
AZ_LOCATION="southeastasia"
AZ_RG="rg-datn"
VM_NAME="vm-datn"

# 2 vCPU / 8 GB. Steady stack ~3.6 GB, peak ~5.6 GB while the Jina encoder loads: 4 GB VMs will not fit.
VM_SIZE="Standard_B2as_v2"
VM_FALLBACK_SIZES="Standard_D2as_v5 Standard_B2ms"

OS_DISK_GB=64
ADMIN_USER="datn"
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"

# VM is deallocated automatically at this time every day (HHMM, UTC). 15:00 UTC = 22:00 in Vietnam.
AUTO_SHUTDOWN_UTC="1500"
AUTO_SHUTDOWN_EMAIL=""

# Personal ceiling used for the portal budget you create by hand (see README); not enforced by the scripts.
BUDGET_USD=60
