# Copy to .env (git-ignored) next to docker-compose.yml. Never commit real keys.

# ---- LLM for the RAG chatbot (Gemini through Google's OpenAI-compatible endpoint) ----
# Get a key at https://aistudio.google.com/apikey . Leave RAG_LLM_BASE_URL empty to run without an LLM.
RAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAG_LLM_MODEL=gemini-3.5-flash-lite
RAG_LLM_API_KEY=
# "low" keeps Gemini's internal thinking short (lower latency/cost); leave empty for the model default.
RAG_LLM_REASONING_EFFORT=low
RAG_LLM_MAX_TOKENS=1024

# ---- Optional AI containers -------------------------------------------------------
# `docker compose up -d` starts only Postgres, Qdrant and the backend (~1--2 GB
# on a typical dev dataset). Start the heavyweight services only when needed:
#   docker compose --profile ai up -d --build
# Then uncomment these URLs so the backend uses them. With them blank, the
# backend uses its built-in catalog/Qdrant/keyword fallbacks without timeouts.
# DATN_RECOMMENDER_URL=http://recommender:8100
# DATN_RAG_URL=http://rag:8200

# Memory ceilings can be raised for a larger dataset. They are hard Docker
# limits, so a service that genuinely needs more exits instead of exhausting
# the whole host. ML_NUM_THREADS also limits native Torch/BLAS worker pools.
# POSTGRES_MEMORY_LIMIT=512m
# QDRANT_MEMORY_LIMIT=768m
# BACKEND_MEMORY_LIMIT=512m
# RECOMMENDER_MEMORY_LIMIT=1400m
# RAG_MEMORY_LIMIT=5g   # loading peaks ~4.4 GB, steady ~2.5 GB; swap is disabled
# ML_NUM_THREADS=2
