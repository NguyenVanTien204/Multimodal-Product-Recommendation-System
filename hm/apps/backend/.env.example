POSTGRES_DB=mini_market
POSTGRES_USER=mini_market
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+psycopg://mini_market:change-me-in-local-env@postgres:5432/mini_market
JWT_SECRET=replace-with-a-long-random-secret
QDRANT_URL=http://qdrant:6333
# Retrieval+reranking model service (hm/apps/recommender). Leave unset to disable
# and always use the Qdrant/catalog-popularity fallback.
DATN_RECOMMENDER_URL=http://recommender:8100
# "cpu" or "cuda" -- passed to the recommender container as DATN_DEVICE.
RECOMMENDER_DEVICE=cpu
CORS_ORIGINS=http://localhost:3000
